public static void SelectionSort(int[]);
  descriptor: ([I)V
  flags: (0x0009) ACC_PUBLIC, ACC_STATIC
  //local_0=arr (the argument), local_1=i, local_2=least, local_3=j, and later local_3 gets reused as tmp once j is no longer needed
  Code:
    stack=4, locals=4, args_size=1
       0: iconst_0        //push 0
       1: istore_1        //i = 0
       2: iload_1         //push i
       3: aload_0         //push arr
       4: arraylength     //push arr.length
       5: if_icmpge     57  //if i >= arr.length jump to the return (outer loop test)
       8: iload_1         //push i
       9: istore_2        //least = i
      10: iload_1         //push i
      11: iconst_1        //push 1
      12: iadd            //i + 1
      13: istore_3        //j = i + 1
      14: iload_3         //push j
      15: aload_0         //push arr
      16: arraylength     //push arr.length
      17: if_icmpge     37  //if j >= arr.length jump past the inner loop (inner loop test)
      20: aload_0         //push arr
      21: iload_3         //push j
      22: iaload          //push arr[j]
      23: aload_0         //push arr
      24: iload_2         //push least
      25: iaload          //push arr[least]
      26: if_icmpge     31  //if arr[j] >= arr[least] skip the update (if-body is empty)
      29: iload_3         //push j
      30: istore_2        //least = j
      31: iinc          3, 1  //j = j + 1
      34: goto          14  //back to the inner loop test
      37: aload_0         //push arr
      38: iload_1         //push i
      39: iaload          //push arr[i]
      40: istore_3        //tmp = arr[i]   (local_3 now holds tmp instead of j)
      41: aload_0         //push arr
      42: iload_1         //push i
      43: aload_0         //push arr
      44: iload_2         //push least
      45: iaload          //push arr[least]
      46: iastore         //arr[i] = arr[least]
      47: aload_0         //push arr
      48: iload_2         //push least
      49: iload_3         //push tmp
      50: iastore         //arr[least] = tmp
      51: iinc          1, 1  //i = i + 1
      54: goto          2   //back to the outer loop test
      57: return          //done, SelectionSort is void so nothing is pushed back
